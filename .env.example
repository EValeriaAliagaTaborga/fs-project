# Copia este archivo como .env antes de levantar el proyecto:  cp .env.example .env
# Son valores de EJEMPLO solo para desarrollo local con Docker: nunca los uses en producción.

# Credenciales de la base de datos PostgreSQL que crea el contenedor
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_DB=appdb

# Secreto con el que se firman los JWT. Para algo real genera uno propio con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=solo-para-desarrollo-local-cambiar-en-produccion