# Copia este archivo como .env y completa los valores en tu máquina.
# .env está en .gitignore: nunca subas secretos reales al repositorio.

# Cadena de conexión a PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_DB?schema=public
DATABASE_URL=

# Secreto con el que se firman los JWT. Usa una cadena larga y aleatoria.
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Puerto en el que escucha la API. Si se omite, se usa 3000.
PORT=3000
