# Copia este archivo como .env y completa el valor si necesitas apuntar a otro backend.
# .env está en .gitignore: nunca subas valores reales al repositorio.
# Vite solo expone al navegador las variables cuyo nombre empieza con VITE_,
# así que aquí no deben guardarse secretos: todo lo que se ponga viaja en el bundle.

# URL base de la API. Si se omite, el frontend usa http://localhost:3000
VITE_API_URL=
